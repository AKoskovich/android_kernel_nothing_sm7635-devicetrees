&tlmm {
	ai_key_default:ai_key_default {
		mux {
			pins = "gpio71";
			function = "gpio";
		};
		config {
			pins = "gpio71";
			drive-strength = <2>;
			bias-disable;
		};
	};
};

#include "wl28681.dtsi"
